# Copie este arquivo para .env e ajuste os valores antes de subir o docker-compose.
# O .env nunca deve ser commitado no Git (ja esta no .gitignore).

DB_NAME=flowops
DB_USER=flowops
DB_PASSWORD=flowops

# Gere uma chave forte para producao, por exemplo com: openssl rand -hex 32
JWT_SECRET=troque-esta-chave-em-producao-minimo-256-bits-0123456789abcdef
JWT_EXPIRATION_MINUTES=60

CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080/api/v1
