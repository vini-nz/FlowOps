# Copie este arquivo para .env e ajuste os valores antes de subir o docker-compose.
# O .env nunca deve ser commitado no Git (ja esta no .gitignore).

DB_NAME=flowops
DB_USER=flowops
DB_PASSWORD=flowops

# Gere uma chave forte para producao, por exemplo com: openssl rand -hex 32
JWT_SECRET=troque-esta-chave-em-producao-minimo-256-bits-0123456789abcdef
JWT_EXPIRATION_MINUTES=60

CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8080/api/v1

# --- Storage de evidencias (V2.6) ---
# Local: MinIO do docker-compose. Em producao, aponte para S3/R2/B2 e troque
# as credenciais - o codigo usa o SDK S3 padrao, nao muda nada.
STORAGE_ACCESS_KEY=flowops
STORAGE_SECRET_KEY=flowops123
STORAGE_BUCKET=flowops-evidences
# Endpoint que o BACKEND usa (rede interna do compose).
STORAGE_ENDPOINT=http://storage:9000
# Endpoint que o NAVEGADOR usa. A URL pre-assinada e assinada para este host,
# entao ele precisa ser alcancavel pelo browser - por isso e diferente do de
# cima quando se roda via Docker.
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
